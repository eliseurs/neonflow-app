{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run test)",
      "Bash(npm run test:legacy)",
      "Bash(npm run wiki:validate)",
      "Bash(npm run check)",
      "Bash(node tests/legacy/03_TESTES.cjs .)",
      "Bash(node scripts/validate-wiki.mjs)",
      "Bash(node --check:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(npm run test:server)",
      "Bash(node --test tests/server.test.mjs)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Edit(./tests/legacy/**)",
      "Write(./tests/legacy/**)",
      "Edit(./dist/**)",
      "Write(./dist/**)"
    ]
  }
}
